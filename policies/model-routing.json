{
  "schema_version": 1,
  "provider": "openai",
  "tested_cli_baseline": "0.153.3",
  "economical_routing_default_enabled": true,
  "economical_routing_require_attestation": false,
  "minimum_attestation": {
    "paired_runs": 8,
    "quality_checks": 8,
    "lifetime_days": 30,
    "minimum_cost_or_comparable_token_improvement_percent": 15,
    "maximum_wall_time_regression_percent": 15
  },
  "service_tier": "unchanged",
  "independent_reviewer": "inherit-parent",
  "primary_preference": {
    "model": "gpt-5.6-sol",
    "effort": "medium",
    "changes_host_model_setting": false
  },
  "quality_escalation": {
    "enabled": true,
    "model": "gpt-6-astra",
    "effort": "high",
    "role": "default",
    "review_role": "code-reviewer",
    "reasons": {
      "research_methodology": ["exploration", "review"],
      "architecture_tradeoff": ["exploration", "review"],
      "complex_debugging": ["exploration", "implementation", "review"],
      "high_risk_review": ["review"],
      "complex_computer_use": ["exploration", "implementation"]
    }
  },
  "routes": {
    "mechanical": {
      "model": "gpt-5.6-luna",
      "effort": "low",
      "role": "portable-mechanical"
    },
    "exploration": {
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "role": "portable-explorer"
    },
    "implementation": {
      "model": "gpt-5.6-sol",
      "effort": "medium",
      "role": "portable-worker"
    }
  },
  "direct_categories": [
    "trivial",
    "governance",
    "security",
    "review"
  ]
}
